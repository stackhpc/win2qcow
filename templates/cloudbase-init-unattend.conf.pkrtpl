# cloudbase-init configuration for the sysprep specialize pass (runs once,
# before OOBE). Creates the user and extends C:. The hostname is left to the
# service (cloudbase-init.conf): Windows 11 OOBE would overwrite it.
# Rendered by Packer.

[DEFAULT]
username=${username}
# Localised group name: change it for non-English ISOs (e.g. Administratoren).
groups=Administrators
inject_user_password=true

metadata_services=cloudbaseinit.metadata.services.configdrive.ConfigDriveService,cloudbaseinit.metadata.services.httpservice.HttpService

plugins=cloudbaseinit.plugins.common.mtu.MTUPlugin,
        cloudbaseinit.plugins.windows.createuser.CreateUserPlugin,
        cloudbaseinit.plugins.windows.extendvolumes.ExtendVolumesPlugin

allow_reboot=false
stop_service_on_exit=false
mtu_use_dhcp_config=true
ntp_use_dhcp_config=true
check_latest_version=false

bsdtar_path=${install_dir}\bin\bsdtar.exe
mtools_path=${install_dir}\bin\
local_scripts_path=${install_dir}\LocalScripts\

verbose=true
debug=true
logdir=${install_dir}\log\
logfile=cloudbase-init-unattend.log
default_log_levels=comtypes=INFO,suds=INFO,iso8601=WARN,requests=WARN
logging_serial_port_settings=COM1,115200,N,8

[config_drive]
types=iso,vfat
locations=partition,hdd,cdrom
